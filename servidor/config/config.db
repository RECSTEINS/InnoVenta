const dotenv = require("dotenv");
dotenv.config();

const mysql = require('mysql2');
let connection;

try{
    connection = mysql.createConnection({
        host: process.env.DBHOST || 'localhost',
        user: process.env.DBUSER || 'root',
        password: process.env.DBPASS || '',
        database: process.env.DBNAME || 'innoventa',
        port: process.env.DBPORT || 3306
    });

    // Verificar la conexión
    connection.connect((err) => {
        if (err) {
            console.error('Error al conectar con la base de datos:', err.message);
            console.error('Asegúrate de que:');
            console.error('1. MySQL esté ejecutándose');
            console.error('2. Las credenciales en .env sean correctas');
            console.error('3. La base de datos exista');
        } else {
            console.log('Conexión a MySQL establecida correctamente');
        }
    });
}catch(error){
    console.error("Error al crear la conexión con la base de datos:", error.message);
}

module.exports = {connection};